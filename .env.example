# Variables de entorno para Supabase
# Renombra este archivo a .env.local y completa los valores

# Supabase URL (Configuración -> API)
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url

# Supabase Anon Key (Configuración -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Supabase Service Role Key (Configuración -> API -> service_role)
# ¡IMPORTANTE! Esta llave es secreta y solo se usa en scripts de servidor o administración
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# URL de la base de datos para scripts de PostgreSQL directo (Configuración -> Database -> Connection string)
DATABASE_URL=tu_database_connection_url

# URL de redirección para autenticación
NEXT_PUBLIC_SITE_URL=http://localhost:3000
